<!-- ========================= -->
<!-- 🟢 成功訊息顯示區塊 -->
<!-- *ngIf="successMessage"：如果 successMessage 有值就顯示這個 div -->
<!-- {{ successMessage }} 會把 TS 裡的 successMessage 文字渲染到畫面上 -->
<div *ngIf="successMessage" style="color: green; font-weight: bold; margin-bottom: 10px;">
  {{ successMessage }}
</div>

<!-- ========================= -->
<!-- 🔴 錯誤訊息顯示區塊 -->
<!-- *ngIf="errorMessage"：如果 errorMessage 有值就顯示 -->
<div *ngIf="errorMessage" style="color: red; font-weight: bold; margin-bottom: 10px;">
  {{ errorMessage }}
</div>

<!-- ========================= -->
<!-- 🔵 Loading 狀態顯示區塊 -->
<!-- *ngIf="loading"：當 loading 為 true，顯示資料載入中 -->
<div *ngIf="loading" style="color: blue; font-weight: bold; margin-bottom: 10px;">
  ⏳ 資料載入中...
</div>

<!-- ========================= -->
<!-- ✏️ 編輯藥品表單 -->
<!-- *ngIf="selectedMedicine"：當有選中藥品才顯示 -->
<div *ngIf="selectedMedicine">
  <h3>編輯藥品</h3>
  <!-- [(ngModel)] 雙向綁定：input 裡的值會同步到 TS 的 selectedMedicine -->
  <input [(ngModel)]="selectedMedicine.name" placeholder="名稱" />
  <input [(ngModel)]="selectedMedicine.category" placeholder="類別" />
  <input type="number" [(ngModel)]="selectedMedicine.price" placeholder="價格" />

  <!-- (click)="saveEdit()"：按下儲存呼叫 TS 的 saveEdit() 方法 -->
  <button (click)="saveEdit()">儲存</button>

  <!-- (click)="selectedMedicine = null"：取消編輯，清空 selectedMedicine -->
  <button (click)="selectedMedicine = null">取消</button>
</div>

<!-- ========================= -->
<!-- ➕ 新增藥品表單 -->
<h3>新增藥品</h3>
<!-- input 雙向綁定 newMedicine 物件 -->
<input [(ngModel)]="newMedicine.name" placeholder="名稱" />
<input [(ngModel)]="newMedicine.category" placeholder="類別" />
<input type="number" [(ngModel)]="newMedicine.price" placeholder="價格" />

<!-- (click)="addMedicine()"：按下新增呼叫 TS 的 addMedicine() -->
<button (click)="addMedicine()">新增</button>

<!-- ========================= -->
<!-- 🔍 搜尋欄 -->
<!-- 雙向綁定 searchTerm，會影響 filteredMedicines 的結果 -->
<input [(ngModel)]="searchTerm" placeholder="搜尋藥品名稱" />

<!-- ========================= -->
<!-- 📋 藥品清單顯示 -->
<h3>藥品清單</h3>
<table border="1">
  <tr>
    <th>名稱</th>
    <th>類別</th>
    <th>價格</th>
    <th>操作</th>
  </tr>

  <!-- *ngFor="let med of filteredMedicines"：迭代 filteredMedicines 陣列，每一筆資料變成 med -->
  <tr *ngFor="let med of filteredMedicines">
    <td>{{ med.name }}</td> <!-- 顯示藥品名稱 -->
    <td>{{ med.category }}</td> <!-- 顯示藥品類別 -->
    <td>{{ med.price }}</td> <!-- 顯示藥品價格 -->
    <td>
      <!-- 編輯按鈕：呼叫 editMedicine(med) 將這筆資料設定為 selectedMedicine -->
      <button (click)="editMedicine(med)">編輯</button>
      <!-- 刪除按鈕：呼叫 deleteMedicine(med) -->
      <button (click)="deleteMedicine(med)">刪除</button>
    </td>
  </tr>
</table>
